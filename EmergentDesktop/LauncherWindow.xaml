<local:WidgetWindow x:Class="EmergentDesktop.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:EmergentDesktop"
    Width="270" Height="575" Background="Transparent" WindowStyle="None"
    AllowsTransparency="True" ShowInTaskbar="False" ResizeMode="NoResize"
    Topmost="False" WindowStartupLocation="Manual">
    <Border Style="{StaticResource PanelShell}">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
                <Grid Height="34" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" Cursor="SizeAll">
                    <TextBlock Text="MISSION LAUNCHER" Style="{StaticResource Title}"/>
                    <TextBlock Text="•••" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Right" FontSize="15"/>
                </Grid>
                <Border Background="{StaticResource FineLine}" Height="1" Margin="0,0,0,8"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <Border Background="{StaticResource FineLine}" Height="1" Margin="0,8,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource ActionButton}" Content="EDIT LINKS" Margin="0,0,6,0"
                            FontSize="9" Click="EditLinks_Click"/>
                    <Button Style="{StaticResource ActionButton}" Content="RELOAD" Margin="6,0,0,0"
                            FontSize="9" Click="Reload_Click"/>
                </StackPanel>
                <TextBlock Text="CLICK TO LAUNCH · APPROVED APPS ONLY" Margin="0,11,0,0"
                           FontFamily="Consolas" FontSize="8" Foreground="{StaticResource SubtleText}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="LauncherGroups"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</local:WidgetWindow>
