<local:WidgetWindow x:Class="EmergentDesktop.HeaderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:EmergentDesktop"
    Width="1200" Height="55" Background="Transparent" WindowStyle="None"
    AllowsTransparency="True" ShowInTaskbar="False" ResizeMode="NoResize"
    Topmost="False" SnapsToDevicePixels="True" WindowStartupLocation="Manual">
    <Border Style="{StaticResource PanelShell}" Padding="16,8">
        <Grid MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" Cursor="SizeAll">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="△" Foreground="{StaticResource Cyan}" FontSize="26"
                       FontFamily="Segoe UI Symbol" VerticalAlignment="Center" Margin="0,-4,15,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="E M E R G E N T   L A B" Foreground="{StaticResource PrimaryText}"
                           FontSize="13" FontFamily="Segoe UI Semibold"/>
                <TextBlock Text="  //  COMMAND DECK" Foreground="{StaticResource Cyan}"
                           FontSize="11" VerticalAlignment="Center" FontFamily="Consolas"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                <Ellipse x:Name="StatusLight" Width="8" Height="8" Fill="#49F0BD" Margin="0,0,8,0">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1"
                                                     Duration="0:0:1.4"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="LOCAL / ONLINE" Foreground="#67F1C7" FontFamily="Consolas"
                           FontSize="10" Margin="0,0,22,0"/>
                <TextBlock x:Name="HeaderDate" Text="—" Foreground="{StaticResource SubtleText}"
                           FontSize="10" FontFamily="Consolas"/>
            </StackPanel>
            <Button Grid.Column="3" Style="{StaticResource ActionButton}" Content="EXIT"
                    FontSize="9" Padding="8,4" ToolTip="Exit Emergent Desktop" Click="Exit_Click"/>
        </Grid>
    </Border>
</local:WidgetWindow>
