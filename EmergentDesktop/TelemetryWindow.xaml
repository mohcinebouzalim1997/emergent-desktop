<local:WidgetWindow x:Class="EmergentDesktop.TelemetryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:EmergentDesktop"
    Width="270" Height="527" Background="Transparent" WindowStyle="None"
    AllowsTransparency="True" ShowInTaskbar="False" ResizeMode="NoResize"
    Topmost="False" WindowStartupLocation="Manual">
    <Border Style="{StaticResource PanelShell}">
        <StackPanel>
            <Grid Height="34" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" Cursor="SizeAll">
                <TextBlock Text="SYSTEM TELEMETRY" Style="{StaticResource Title}" VerticalAlignment="Top"/>
                <TextBlock Text="•••" Foreground="{StaticResource SubtleText}" HorizontalAlignment="Right"
                           FontSize="15" VerticalAlignment="Top"/>
            </Grid>
            <Border Background="{StaticResource FineLine}" Height="1" Margin="0,0,0,19"/>

            <Grid>
                <TextBlock Text="CPU // ALL CORES" Style="{StaticResource Label}"/>
                <TextBlock x:Name="CpuText" Text="SAMPLING" HorizontalAlignment="Right"
                           Foreground="{StaticResource Cyan}" FontFamily="Consolas" FontSize="16"/>
            </Grid>
            <Border Background="{StaticResource GlassInner}" CornerRadius="5" Height="72" Margin="0,13,0,7">
                <Grid Margin="5">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="1" Background="#183D4E" Height="1" VerticalAlignment="Center"/>
                    <Canvas Grid.RowSpan="2" Width="219" Height="58" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Polyline x:Name="CpuGraph" Stroke="{StaticResource Cyan}" StrokeThickness="2"
                                  StrokeLineJoin="Round" SnapsToDevicePixels="True"/>
                    </Canvas>
                </Grid>
            </Border>
            <TextBlock Text="1s SAMPLE / LOCAL COUNTERS" Style="{StaticResource Label}" FontSize="9"/>

            <Border Background="{StaticResource FineLine}" Height="1" Margin="0,24,0,19"/>
            <Grid>
                <TextBlock Text="PHYSICAL MEMORY" Style="{StaticResource Label}"/>
                <TextBlock x:Name="RamText" Text="—" HorizontalAlignment="Right"
                           Foreground="{StaticResource Amber}" FontFamily="Consolas" FontSize="16"/>
            </Grid>
            <ProgressBar x:Name="RamBar" Minimum="0" Maximum="100" Value="0"
                         Height="7" Background="#183D4E" Foreground="{StaticResource Amber}"
                         BorderThickness="0" Margin="0,14,0,7"/>
            <TextBlock x:Name="RamAmount" Text="— GiB USED" Style="{StaticResource Label}" FontSize="10"/>

            <Border Background="{StaticResource FineLine}" Height="1" Margin="0,25,0,18"/>
            <TextBlock Text="NETWORK ACTIVITY" Style="{StaticResource Label}"/>
            <Grid Margin="0,16,0,8">
                <TextBlock Text="↓  DOWN" Foreground="{StaticResource Cyan}" FontFamily="Consolas" FontSize="12"/>
                <TextBlock x:Name="DownloadText" Text="0.0 B/s" HorizontalAlignment="Right"
                           Foreground="{StaticResource PrimaryText}" FontFamily="Consolas" FontSize="12"/>
            </Grid>
            <Grid>
                <TextBlock Text="↑  UP" Foreground="{StaticResource Amber}" FontFamily="Consolas" FontSize="12"/>
                <TextBlock x:Name="UploadText" Text="0.0 B/s" HorizontalAlignment="Right"
                           Foreground="{StaticResource PrimaryText}" FontFamily="Consolas" FontSize="12"/>
            </Grid>
            <Border Background="{StaticResource FineLine}" Height="1" Margin="0,24,0,13"/>
            <TextBlock Text="NO NETWORK REQUESTS · NO DATA UPLOAD"
                       Foreground="{StaticResource SubtleText}" FontFamily="Consolas" FontSize="8"/>
        </StackPanel>
    </Border>
</local:WidgetWindow>
